
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "schedule": [
    "* 0-23 * * *"
  ],
  "timezone": "Australia/Sydney",
  "updateNotScheduled": false,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 10,
    "vulnerabilityFixStrategy": "lowest"
  }
}
